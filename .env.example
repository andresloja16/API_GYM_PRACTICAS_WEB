# Variables del backend: establecer en la terminal antes de ejecutarlo.
# Spring Boot no carga este archivo automáticamente.
PORT=3000
SEED_DEMO=true
DB_URL=jdbc:h2:file:./data/pulse;DB_CLOSE_ON_EXIT=FALSE
DB_USER=sa
DB_PASSWORD=
# Opcional en desarrollo: 32 bytes aleatorios codificados en Base64.
# Sin JWT_SECRET, la clave se genera por arranque y las sesiones anteriores expiran.
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
